<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

        <import type="android.view.View" />

        <import type="android.widget.LinearLayout" />

        <import type="me.tatarka.bindingcollectionadapter2.LayoutManagers" />

        <import type="io.yoba.yandex.school.activities.CustomItemDecorators" />

        <variable
            name="viewModel"
            type="io.yoba.yandex.school.activities.table.ImageTableActivityViewModel" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <android.support.v4.widget.SwipeRefreshLayout
            android:id="@+id/imageTableActivitySwipeRefreshLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <android.support.v7.widget.RecyclerView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="@{viewModel.isImageTableVisible ? View.VISIBLE : View.GONE }"
                app:itemBinding="@{viewModel.itemBinding}"
                app:itemDecorator="@{CustomItemDecorators.GRID_SPACE.name}"
                app:items="@{viewModel.images}"
                app:layoutManager="@{LayoutManagers.grid(2)}" />
        </android.support.v4.widget.SwipeRefreshLayout>
    </LinearLayout>
</layout>